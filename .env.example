# OpenRouter (gateway OpenAI-compatible). Renomeie para .env e cole sua chave.
# IMPORTANTE: a chave fica embutida no bundle Vite — antes de deployar
# em ambiente público, mova as chamadas LLM para uma Vercel/Edge Function
# lendo OPENROUTER_API_KEY do servidor (sem o prefixo VITE_).

VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo único pra todas as etapas. Gemini 3 Flash Preview tem reasoning
# embutido (controlado pelo parâmetro reasoning.effort do OpenRouter).
# Contexto 1,05M tokens · US$ 0,50/M input · US$ 3,00/M output ·
# prompt caching automático.
VITE_OPENROUTER_MODEL=google/gemini-3-flash-preview

# Esforço de reasoning padrão: minimal | low | medium | high.
# Cada caller pode sobrescrever (matcher usa medium, classify usa low).
VITE_OPENROUTER_REASONING_EFFORT=medium

# (Opcional) Cabeçalhos de atribuição para o ranking público do OpenRouter.
# Ajudam o app a aparecer com nome próprio nas estatísticas.
VITE_OPENROUTER_HTTP_REFERER=https://comparador-orcamentos.local
VITE_OPENROUTER_APP_TITLE=Comparador de Orcamentos
