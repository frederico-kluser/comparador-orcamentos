# Cole sua chave OpenRouter aqui (renomear este arquivo para .env)
# IMPORTANTE: ao deployar, mover esta chave para uma Vercel Function (não expor no client).
# Para POC local, esta abordagem é aceitável.
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_OPENROUTER_MODEL=google/gemini-2.5-flash-lite
