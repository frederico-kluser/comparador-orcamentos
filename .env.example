# DeepSeek API direto. Renomeie para .env e cole sua chave em VITE_DEEPSEEK_API_KEY.
# IMPORTANTE: a chave fica embutida no bundle Vite — antes de deployar,
# mover as chamadas LLM para uma Vercel Function lendo DEEPSEEK_API_KEY
# do servidor (não expor no client).

VITE_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Etapa de classificação (rápida, leve): deepseek-v4-flash
VITE_DEEPSEEK_MODEL_CLASSIFY=deepseek-v4-flash

# Etapa de correlação (pesada, raciocínio): deepseek-v4-pro
VITE_DEEPSEEK_MODEL_MATCH=deepseek-v4-pro
